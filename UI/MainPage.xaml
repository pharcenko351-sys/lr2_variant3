<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DormitoryXml.Code.Models"
             x:Class="DormitoryXml.UI.MainPage"
             Title="Гуртожиток"
             BackgroundColor="#16181D">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#E5E7EB" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="#E5E7EB" />
            <Setter Property="TitleColor" Value="#9CA3AF" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#E5E7EB" />
            <Setter Property="PlaceholderColor" Value="#6B7280" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#3B82F6" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12" Padding="20">

        <HorizontalStackLayout Grid.Row="0" Spacing="12">
            <Button Text="Завантажити XML" Clicked="OnLoadXmlClicked" />
            <Button Text="Обрати XSL" Clicked="OnSelectXslClicked" BackgroundColor="#4B5563" />
            <VerticalStackLayout VerticalOptions="Center">
                <Label x:Name="XmlPathLabel" Text="XML-файл не обрано" />
                <Label x:Name="XslLabel" Text="XSL-файл не обрано" TextColor="#9CA3AF" FontSize="12" />
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
            <Picker x:Name="FacultyPicker" Title="Факультет" Grid.Row="0" Grid.Column="0" />
            <Picker x:Name="DepartmentPicker" Title="Кафедра" Grid.Row="0" Grid.Column="1" />
            <Picker x:Name="CoursePicker" Title="Курс" Grid.Row="0" Grid.Column="2" />
            <Picker x:Name="BuildingPicker" Title="Гуртожиток" Grid.Row="1" Grid.Column="0" />
            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="0" VerticalOptions="Start">
                <Label Text="Ключове слово" TextColor="#9CA3AF" FontSize="14" Margin="0,0,0,4" />
                <Entry x:Name="KeywordEntry" Placeholder="ПІП, телефон, кімната"
                       HeightRequest="40" FontSize="14" VerticalOptions="Start" />
            </VerticalStackLayout>
            <Picker x:Name="StrategyPicker" Title="Спосіб аналізу" Grid.Row="1" Grid.Column="2" />
        </Grid>

        <HorizontalStackLayout Grid.Row="2" Spacing="12">
            <Button Text="Знайти" Clicked="OnSearchClicked" />
            <Button Text="Clear" Clicked="OnClearClicked" BackgroundColor="#4B5563" />
        </HorizontalStackLayout>

        <Label Grid.Row="3" x:Name="ResultsLabel" Text="Результати" FontAttributes="Bold" />

        <CollectionView Grid.Row="4" x:Name="ResultsView" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Student">
                    <VerticalStackLayout Padding="0,6" Spacing="1">
                        <Label Text="{Binding FullName}" FontAttributes="Bold" />
                        <Label Text="{Binding Subtitle}" TextColor="#9CA3AF" FontSize="13" />
                        <Label Text="{Binding PhoneText}" TextColor="#9CA3AF" FontSize="13" />
                        <Label Text="{Binding ResidencesText}" TextColor="#9CA3AF" FontSize="13" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Button Grid.Column="1" Text="Трансформувати в HTML" Clicked="OnTransformClicked" />
            <Button Grid.Column="2" Text="Вийти" Clicked="OnExitRequested" BackgroundColor="#B91C1C" />
        </Grid>

        <Label Grid.Row="6" x:Name="StatusLabel" TextColor="#9CA3AF" FontSize="12"
               Text="Спочатку завантажте XML." />
    </Grid>
</ContentPage>
